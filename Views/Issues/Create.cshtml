@using Issue_tracker.Models
@model Issue
@{
    ViewData["Title"] = "New Issue";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card form-card">
            <div class="card-body p-4">
                <h2 class="page-title mb-4">New Issue</h2>

                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ProjectId" class="form-label fw-semibold">Project</label>
                            <select asp-for="ProjectId" asp-items="(List<SelectListItem>)ViewBag.Projects" class="form-select"></select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ReporterId" class="form-label fw-semibold">Reporter</label>
                            <select asp-for="ReporterId" asp-items="(List<SelectListItem>)ViewBag.Users" class="form-select"></select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Priority" class="form-label fw-semibold"></label>
                            <select asp-for="Priority" asp-items="Html.GetEnumSelectList<Priority>()" class="form-select"></select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Status" class="form-label fw-semibold"></label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<Status>()" class="form-select"></select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="AssigneeId" class="form-label fw-semibold">Assignee</label>
                            <select asp-for="AssigneeId" asp-items="(List<SelectListItem>)ViewBag.Users" class="form-select">
                                <option value="">Unassigned</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save issue</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>