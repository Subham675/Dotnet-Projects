@using Issue_tracker.Models
@model List<Project>
@{
    ViewData["Title"] = "Projects";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title mb-1">Projects</h1>
        <p class="text-muted mb-0">@Model.Count project(s)</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-lg">+ New Project</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state text-center">
        <div class="empty-icon">📁</div>
        <h4>No projects yet</h4>
        <p class="text-muted">Create your first project to get started.</p>
        <a asp-action="Create" class="btn btn-primary">+ New Project</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var p in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card project-card h-100">
                    <div class="card-body d-flex align-items-center">
                        <div class="project-avatar">
                            @(string.IsNullOrEmpty(p.Name) ? "?" : p.Name.Substring(0, 1).ToUpper())
                        </div>
                        <div class="ms-3">
                            <h5 class="card-title mb-1">
                                <a asp-controller="Issues" asp-action="Index" asp-route-projectId="@p.Id" class="text-decoration-none text-dark">@p.Name</a>
                            </h5>
                            <span class="badge bg-light text-secondary">ID #@p.Id</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}